COMPOSE_PROJECT_NAME=tripblogger
# Kept as-is by `npm run secrets:init`: the mssql_data volume already uses it (see docs/runbooks/secrets.md).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# Sample values below are replaced with random ones by `npm run secrets:init`;
# services refuse to boot in production while they are still samples.
TYPESENSE_API_KEY=xyz_typesense_dev_key_change_me
JWT_ACCESS_SECRET=change_this_access_secret_123456
JWT_REFRESH_SECRET=change_this_refresh_secret_123456
ADMIN_SECRET=change_this_admin_secret_123456
GEO_INTERNAL_TOKEN=change_this_geo_internal_token_123456
S3_ACCESS_KEY=tripblogger
S3_SECRET_KEY=change_this_s3_secret_123456
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
GOOGLE_OAUTH_AUDIENCES=your_google_web_client_id
DATA_ROOT=D:/tripblogger-data
JWT_ACCESS_PRIVATE_KEY_PATH=/run/secrets/jwt_access_private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=/run/secrets/jwt_access_public.pem
# Optional local services. Leave empty unless the matching profile is running:
#   --profile search   -> TYPESENSE_HOST=typesense
#   --profile geocoder -> PHOTON_URL=http://photon:2322
TYPESENSE_HOST=
PHOTON_URL=
# Reverse geocoding when the local Photon is not configured or down. Free, fair-use.
PHOTON_FALLBACK_URL=https://photon.komoot.io
# Set to http://jaeger:4318 when running the "obs" profile to export traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Requests per minute per client IP on Geo/Trip; raise it before `npm run load:test`.
THROTTLE_LIMIT=300
