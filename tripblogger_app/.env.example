# Trên Expo Go điện thoại thật, localhost trỏ vào máy điện thoại ⇒ lỗi Network.
# Dev: có thể giữ localhost; app sẽ tự đổi sang IP Metro khi được.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_EXPO_PROJECT_FOR_PROXY=@your-expo-username/tripblogger_app
