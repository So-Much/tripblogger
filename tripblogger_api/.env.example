NODE_ENV=development
PORT=3000

JWT_ACCESS_SECRET=change_this_access_secret_123456
JWT_REFRESH_SECRET=change_this_refresh_secret_123456
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin-only operations (e.g. ban guest by sessionId)
ADMIN_SECRET=change_this_admin_secret_123456

# Google OAuth ID token audiences (comma-separated client ids)
GOOGLE_OAUTH_AUDIENCES=your_google_web_client_id,another_allowed_client_id

DB_HOST=127.0.0.1
# Use either DB_PORT (default SQL Server) or DB_INSTANCE (named instance like SQLEXPRESS)
DB_PORT=1433
DB_INSTANCE=
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=tripblogger

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
