    "@nestjs/typeorm": "^11.0.1",
    "@tripblogger/auth": "*",
    "@tripblogger/events": "*",
    "@tripblogger/itinerary-engine": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mssql": "^12.5.2",
    "reflect-metadata": "^0.2.2",
