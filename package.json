{
  "name": "tripblogger",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "tripblogger_api",
    "tripblogger_app"
  ],
  "scripts": {
    "test:engine": "npm test -w @tripblogger/itinerary-engine",
    "test:api": "npm test -w tripblogger-api",
    "test:app-plan": "npm test -w tripblogger_app",
    "test:contracts": "npm test -w @tripblogger/contracts",
    "test:auth": "npm test -w @tripblogger/auth",
    "test:events": "npm test -w @tripblogger/events",
    "test:observability": "npm test -w @tripblogger/observability",
    "test:infra": "node --test infra/secrets/secrets-init.test.js",
    "lint:api": "npm run lint -w tripblogger-api",
    "secrets:init": "node infra/secrets/secrets-init.js",
    "backup": "node infra/backup/backup.js",
    "restore": "node infra/backup/backup.js restore",
    "e2e": "node --env-file=.env.compose infra/e2e/flow.js",
    "load:smoke": "docker compose --env-file .env.compose --profile tools run --rm k6 /scripts/smoke.js",
    "load:test": "docker compose --env-file .env.compose --profile tools run --rm k6 /scripts/load.js"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@react-native/virtualized-lists": "0.86.3"
  }
}
