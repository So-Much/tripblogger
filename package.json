{
  "name": "tripblogger",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "tripblogger_api",
    "tripblogger_app"
  ],
  "scripts": {
    "test:engine": "npm test -w @tripblogger/itinerary-engine",
    "test:api": "npm test -w tripblogger-api",
    "test:app-plan": "npm test -w tripblogger_app",
    "test:contracts": "npm test -w @tripblogger/contracts",
    "test:auth": "npm test -w @tripblogger/auth",
    "test:events": "npm test -w @tripblogger/events",
    "lint:api": "npm run lint -w tripblogger-api"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@react-native/virtualized-lists": "0.86.3"
  }
}
